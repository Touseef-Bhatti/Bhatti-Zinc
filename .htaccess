DirectoryIndex index.html

AddType image/webp .webp
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block google verification file on localhost
    RewriteCond %{HTTP_HOST} ^localhost$ [OR]
    RewriteCond %{HTTP_HOST} ^127\.0\.0\.1$
    RewriteRule ^google1a3dd3610a73998a\.html$ - [F,L]

    # Keep the existing clean URLs while serving static HTML files.
    # Redirect requests for the former PHP product route to the matching static page.
    RewriteCond %{THE_REQUEST} \s/+product\.php\?p=([^\s&]+) [NC]
    RewriteRule ^product\.php$ /%1? [R=301,L]

    # Redirect former PHP page URLs to their extensionless public URLs.
    RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.php(?:[?\s]) [NC]
    RewriteRule ^([a-z0-9-]+)\.php$ /$1 [R=301,L]

    # Normalize non-directory clean routes so canonical URLs have no trailing slash.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]

    # Serve an extensionless route from its corresponding static HTML file.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

    # Previously, unknown clean slugs reached the product template and returned to the catalog.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html !-f
    RewriteRule ^([a-z0-9-]+)/?$ /products [R=302,L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
