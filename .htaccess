DirectoryIndex index.html
Options -MultiViews

AddType image/webp .webp
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block google verification file on localhost
    RewriteCond %{HTTP_HOST} ^localhost$ [OR]
    RewriteCond %{HTTP_HOST} ^127\.0\.0\.1$
    RewriteRule ^google1a3dd3610a73998a\.html$ - [F,L]

    # Redirect the former flat product URLs into the products folder.
    RewriteRule ^(apcd-zinc-ash-50-60|iranian-zinc-ingots|secondary-zinc-ingots|shg-zinc-ingots|zinc-alloy-92-94|zinc-ash-65-70|zinc-die-cast-scrap|zinc-dross-94-97|zinc-oxide-99-99|zinc-skimming-30-40)(?:\.html)?$ /products/$1 [R=301,L,NC]

    # Redirect the former catalog file and extensionful page URLs.
    RewriteRule ^products\.html$ /products/ [R=301,L,NC]
    RewriteRule ^products/index\.html$ /products/ [R=301,L,NC]
    RewriteRule ^products/([a-z0-9-]+)\.html$ /products/$1 [R=301,L,NC]
    RewriteRule ^index(?:\.html)?$ / [R=301,L,NC]
    RewriteCond %{REQUEST_URI} !^/google1a3dd3610a73998a\.html$ [NC]
    RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html(?:[?\s]) [NC]
    RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L,NC]

    # Redirect requests for the former PHP product route to its new product URL.
    RewriteCond %{THE_REQUEST} \s/+product\.php\?p=([^\s&]+) [NC]
    RewriteRule ^product\.php$ /products/%1? [R=301,L]

    # Redirect former PHP page URLs to their extensionless public URLs.
    RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.php(?:[?\s]) [NC]
    RewriteRule ^([a-z0-9-]+)\.php$ /$1 [R=301,L]

    # Normalize nested product routes without a trailing slash.
    RewriteRule ^products/([a-z0-9-]+)/$ /products/$1 [R=301,L,NC]

    # Normalize non-directory root routes so canonical URLs have no trailing slash.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]

    # Serve nested product routes from their static HTML files.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^products/([a-z0-9-]+)/?$ products/$1.html [L,NC]

    # Serve root extensionless routes from their matching static HTML files.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

    # Send unknown clean routes to the catalog.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html !-f
    RewriteRule ^([a-z0-9-]+)/?$ /products/ [R=302,L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
